  "html": "<!DOCTYPE html><html lang='en'><head><title>Analytics Dashboard</title></head><body><header><nav role='navigation'><a href='/dashboard'>Dashboard</a><a href='/reports'>Reports</a><a href='/settings' aria-label='Account settings'>Settings</a><a href='/logout' aria-label='Sign out'>Logout</a></nav></header><main><section id='widgets'><div id='widget-revenue' class='widget' role='region' aria-label='Revenue widget'><h2>Revenue</h2><button id='widget-revenue-refresh' aria-label='Refresh revenue data'>↻</button><select id='widget-revenue-range' aria-label='Date range'><option value='7d'>Last 7 days</option><option value='30d'>Last 30 days</option><option value='90d'>Last 90 days</option></select></div><div id='widget-users' class='widget' role='region' aria-label='Users widget'><h2>Active Users</h2><button id='widget-users-refresh' aria-label='Refresh user data'>↻</button><input type='checkbox' id='widget-users-realtime' aria-label='Real-time mode' /><label for='widget-users-realtime'>Real-time</label></div><div id='widget-disabled' class='widget' role='region' aria-label='Locked widget'><h2>Premium Feature</h2><button id='widget-disabled-btn' disabled aria-label='Upgrade to access'>Upgrade Required</button></div></section><section id='data-table' role='table' aria-label='Analytics data table'><input type='search' id='table-search' placeholder='Filter results...' aria-label='Filter table' /><select id='table-page-size' aria-label='Rows per page'><option value='10'>10</option><option value='25'>25</option><option value='50'>50</option></select><button id='export-csv' aria-label='Export as CSV'>Export CSV</button><button id='export-pdf' aria-label='Export as PDF'>Export PDF</button><button id='table-prev' disabled aria-label='Previous page'>← Prev</button><button id='table-next' aria-label='Next page'>Next →</button></section><section id='notifications' role='alert' aria-label='Notifications'><button id='dismiss-notification' aria-label='Dismiss notification'>✕</button><a href='/alerts/123' aria-label='View alert details'>View Details</a></section></main><aside id='sidebar'><h2>Quick Actions</h2><button id='create-report' aria-label='Create new report'>+ New Report</button><button id='schedule-report' aria-label='Schedule report'>Schedule</button><a href='/admin/users' aria-label='Manage users'>Manage Users</a><a href='/admin/audit' aria-label='Audit log'>Audit Log</a></aside><iframe id='embedded-chart' src='https://charts.example.com/embed/revenue' title='Revenue chart'></iframe></body></html>",
