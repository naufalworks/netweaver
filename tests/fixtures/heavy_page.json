  "html": "<html><head><title>E-Commerce Store</title></head><body><header><input type='search' id='product-search' placeholder='Search products...' /><button id='search-btn'>Search</button><nav><a href='/cart'>Cart (0)</a><a href='/account'>Account</a></nav></header><aside id='filters'><h3>Filters</h3><select id='category'><option value='all'>All Categories</option><option value='electronics'>Electronics</option><option value='clothing'>Clothing</option></select><input type='range' id='price-range' min='0' max='500' /><label><input type='checkbox' id='in-stock' /> In Stock Only</label><button id='apply-filters'>Apply</button><button id='clear-filters'>Clear</button></aside><main id='product-grid'><div class='product' data-id='p1'><a href='/products/p1'><h3>Widget A</h3></a><span class='price'>$29.99</span><button class='add-to-cart' data-id='p1'>Add to Cart</button></div><div class='product' data-id='p2'><a href='/products/p2'><h3>Widget B</h3></a><span class='price'>$49.99</span><button class='add-to-cart' data-id='p2'>Add to Cart</button></div><div class='product' data-id='p3'><a href='/products/p3'><h3>Gadget C</h3></a><span class='price'>$19.99</span><button class='add-to-cart' data-id='p3' disabled>Out of Stock</button></div><div class='product' data-id='p4'><a href='/products/p4'><h3>Gadget D</h3></a><span class='price'>$99.99</span><button class='add-to-cart' data-id='p4'>Add to Cart</button></div><div class='product' data-id='p5'><a href='/products/p5'><h3>Tool E</h3></a><span class='price'>$14.99</span><button class='add-to-cart' data-id='p5'>Add to Cart</button></div><div class='product' data-id='p6'><a href='/products/p6'><h3>Tool F</h3></a><span class='price'>$39.99</span><button class='add-to-cart' data-id='p6'>Add to Cart</button></div><div class='product' data-id='p7'><a href='/products/p7'><h3>Device G</h3></a><span class='price'>$199.99</span><button class='add-to-cart' data-id='p7'>Add to Cart</button></div><div class='product' data-id='p8'><a href='/products/p8'><h3>Device H</h3></a><span class='price'>$149.99</span><button class='add-to-cart' data-id='p8' disabled>Out of Stock</button></div><div class='product' data-id='p9'><a href='/products/p9'><h3>Accessory I</h3></a><span class='price'>$9.99</span><button class='add-to-cart' data-id='p9'>Add to Cart</button></div><div class='product' data-id='p10'><a href='/products/p10'><h3>Accessory J</h3></a><span class='price'>$4.99</span><button class='add-to-cart' data-id='p10'>Add to Cart</button></div></main><footer><div id='promo-overlay' style='display:none'><button id='close-promo'>Close Promo</button><a href='/promo'>Shop Sale</a></div><div id='cookie-banner'><p>We use cookies</p><button id='accept-cookies'>Accept</button><button id='decline-cookies'>Decline</button></div><nav><a href='/about'>About</a><a href='/contact'>Contact</a><a href='/terms'>Terms</a><a href='/privacy'>Privacy</a><a href='/faq'>FAQ</a></nav></footer></body></html>",
